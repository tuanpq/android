<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:textStyle="bold"
            android:textSize="20sp"
            android:padding="16dp"
            android:textAllCaps="true"
            android:textColor="#AABBCC"
            android:textAlignment="textStart" />

        <TextView
            android:id="@+id/device_mac_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:textStyle="bold"
            android:textSize="20sp"
            android:padding="16dp"
            android:textAllCaps="true"
            android:textColor="#AABBCC"
            android:textAlignment="textEnd" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#FF00FF" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_dialog_message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:paddingTop="@dimen/list_item_spacing_half"
        android:paddingBottom="@dimen/list_item_spacing_half"
        tools:context=".ChatDialogFragment"
        tools:listitem="@layout/fragment_chat_dialog_message_from_me_item" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:background="#FFFFFF"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1.0"
            android:layout_marginStart="8dp"
            android:autofillHints="@string/message"
            android:inputType="textMultiLine"
            android:textColor="@color/black"
            android:hint="@string/message" />

        <Button
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#A020F0"
            android:textColor="@color/white"
            android:paddingHorizontal="16dp"
            android:layout_marginHorizontal="8dp"
            android:text="@string/send"/>

    </LinearLayout>

</LinearLayout>