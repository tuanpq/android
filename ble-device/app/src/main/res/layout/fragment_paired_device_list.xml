<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:text="@string/paired_device_list" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:name="io.github.tuanpq.bledevice.PairedDeviceFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:background="#FEDCBA"
        app:layoutManager="LinearLayoutManager"
        tools:context=".PairedDeviceFragment"
        tools:listitem="@layout/fragment_paired_device_item" />

</LinearLayout>